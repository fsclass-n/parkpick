# =============================================================
# parkpick 환경 변수 예시 파일
# - 로컬: 이 파일을 .env 로 복사해서 사용 (cp .env.example .env)
# - Render / Netlify: 아래 [RENDER-API] [RENDER-FRONT] [NETLIFY] 표시 항목을 대시보드에 직접 등록
# - 보안 키 원본은 절대 커밋하지 않습니다. (키 이름과 설명만 기록)
# =============================================================

# ---------- [BACKEND] 공통 / [RENDER-API] ----------
APP_ENV=development                         # development | production
# JWT 서명 키 (Render는 generateValue 로 자동 생성)
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRE_MINUTES=720
# 실제 관리자 진입용 보안 키 (로그인 페이지 > 관리자 키 로그인)
ADMIN_SECRET_KEY=change-me-admin-secret
# 실제 관리자 계정 시드 (선택, 비워두면 생성하지 않음)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# DB: 미설정 시 SQLite(backend/storage/parkpick.db) 사용
# TiDB 예) mysql+pymysql://USER:PASSWORD@HOST:4000/parkpick?ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_URL=
# CORS 허용 도메인 (콤마 구분)
CORS_ORIGINS=http://localhost:5173,https://parkpick.netlify.app,https://parkpick.onrender.com
# 프런트엔드 주소 (OAuth 로그인 완료 후 리다이렉트)
FRONTEND_URL=http://localhost:5173
# 백엔드 공개 주소 (OAuth redirect_uri 생성용)
BACKEND_URL=http://localhost:8000
# 실시간 주차면 상태 시뮬레이터 (영상 추론 연동 전 데모용)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=3

# ---------- [BACKEND] OAuth / [RENDER-API] ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- [BACKEND] Generative AI / External API / [RENDER-API] ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 공공데이터포털 주차장 정보 API 인증키
PUBLIC_DATA_API_KEY=

# ---------- [AI] 로컬 학습/추론 ----------
AI_MODEL_PATH=ai/weights/parkpick-yolo.pt
AI_CONF_THRESHOLD=0.45
AI_TRACKER=bytetrack.yaml
AI_API_URL=http://localhost:8000
AI_INGEST_TOKEN=

# ---------- [FRONTEND] / [RENDER-FRONT] / [NETLIFY] ----------
# Netlify 데모: VITE_USE_MOCK=true (백엔드 없이 Mock 데이터로 동작)
# Render 프런트: VITE_USE_MOCK=false, VITE_API_BASE_URL=https://parkpick-api.onrender.com
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000
